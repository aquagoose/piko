{
  "OutputDirectory": "../src/piko.SDL3",
  "Namespace": "piko.SDL3",
  "LibraryDllName": "SDL3",
  "MethodClassName": "SDL",
  "PrefixToStrip": "SDL_",
  "Analyzer": "ClangSharp",
  "ClangSharp": {
    "FileDirectory": "../lib/SDL/include/SDL3",
    "Files": [
      //"SDL_assert.h",
      "SDL_asyncio.h",
      "SDL_atomic.h",
      "SDL_audio.h",
      //"SDL_begin_code.h",
      "SDL_bits.h",
      "SDL_blendmode.h",
      "SDL_camera.h",
      "SDL_clipboard.h",
      //"SDL_close_code.h",
      //"SDL_copying.h",
      "SDL_cpuinfo.h",
      "SDL_dialog.h",
      //"SDL_dlopennote.h",
      //"SDL_egl.h",
      //"SDL_endian.h",
      "SDL_error.h",
      "SDL_events.h",
      "SDL_filesystem.h",
      "SDL_gamepad.h",
      "SDL_gpu.h",
      "SDL_guid.h",
      "SDL.h",
      "SDL_haptic.h",
      "SDL_hidapi.h",
      "SDL_hints.h",
      "SDL_init.h",
      //"SDL_intrin.h",
      "SDL_iostream.h",
      "SDL_joystick.h",
      "SDL_keyboard.h",
      "SDL_keycode.h",
      "SDL_loadso.h",
      "SDL_locale.h",
      "SDL_log.h",
      //"SDL_main.h",
      //"SDL_main_impl.h",
      "SDL_messagebox.h",
      "SDL_metal.h",
      "SDL_misc.h",
      "SDL_mouse.h",
      "SDL_mutex.h",
      //"SDL_oldnames.h",
      //"SDL_opengles2_gl2ext.h",
      //"SDL_opengles2_gl2.h",
      //"SDL_opengles2_gl2platform.h",
      //"SDL_opengles2.h",
      //"SDL_opengles2_khrplatform.h",
      //"SDL_opengles.h",
      //"SDL_opengl_glext.h",
      //"SDL_opengl.h",
      "SDL_openxr.h",
      "SDL_pen.h",
      "SDL_pixels.h",
      //"SDL_platform_defines.h",
      "SDL_platform.h",
      "SDL_power.h",
      "SDL_process.h",
      "SDL_properties.h",
      "SDL_rect.h",
      "SDL_render.h",
      "SDL_revision.h",
      "SDL_scancode.h",
      "SDL_sensor.h",
      //"SDL_stdinc.h",
      "SDL_storage.h",
      "SDL_surface.h",
      "SDL_system.h",
      "SDL_thread.h",
      "SDL_time.h",
      "SDL_timer.h",
      "SDL_touch.h",
      "SDL_tray.h",
      "SDL_version.h",
      "SDL_video.h",
      "SDL_vulkan.h"
    ],
    "IncludeDirectories": ["../lib/SDL/include/"]
  },
  "TypeRemapping": {
    "SDL_InitFlags": "InitFlags",
    "SDL_WindowFlags": "WindowFlags",
    "SDL_GPUShaderFormat": "GPUShaderFormat",
    "SDL_GPUTextureUsageFlags": "GPUTextureUsageFlags",
    "SDL_GPUBufferUsageFlags": "GPUBufferUsageFlags",
    "SDL_MessageBoxFlags": "MessageBoxFlags",
    "SDL_MouseButtonFlags": "MouseButtonFlags",
    "SDL_GLContextResetNotification": "GLContextResetNotification",
    "SDL_GLContextReleaseFlag": "GLContextReleaseFlag",
    "SDL_GLProfile": "GLProfile",
    "SDL_GLContextFlag": "GLContextFlag",
    "SDL_Keycode": "Keycode",
    "SDL_Keymod": "Keymod",
    "SDL_PenInputFlags": "PenInputFlags",
    "SDL_BlendMode": "BlendMode",
    // manually redefine every fnptr so that clangsharp actually generates them as delegates
    // todo find if there's a better way to do this or a way to get clangsharp to output the fnptr name instead of intptr
    "SDL_AudioStreamDataCompleteCallback": "AudioStreamDataCompleteCallback",
    "SDL_AudioStreamCallback": "AudioStreamCallback",
    "SDL_AudioPostmixCallback": "AudioPostmixCallback",
    "SDL_ClipboardDataCallback": "ClipboardDataCallback",
    "SDL_ClipboardCleanupCallback": "ClipboardCleanupCallback",
    "SDL_DialogFileCallback": "DialogFileCallback",
    "SDL_EventFilter": "EventFilter",
    "SDL_EnumerateDirectoryCallback": "EnumerateDirectoryCallback",
    "SDL_HitCallback": "HitCallback",
    "SDL_AppInitFunc": "AppInitFunc",
    "SDL_AppIterateFunc": "AppIterateFunc",
    "SDL_AppEventFunc": "AppEventFunc",
    "SDL_AppQuitFunc": "AppQuitFunc",
    "SDL_MainThreadCallback": "MainThreadCallback",
    "SDL_LogOutputFunction": "LogOutputFunction",
    "SDL_MouseMotionTransformCallback": "MouseMotionTransformCallback",
    "SDL_CleanupPropertyCallback": "CleanupPropertyCallback",
    "SDL_EnumeratePropertiesCallback": "EnumeratePropertiesCallback",
    "SDL_X11EventHook": "X11EventHook",
    "SDL_ThreadFunction": "ThreadFunction",
    "SDL_TLSDestructorCallback": "TLSDestructorCallback",
    "SDL_TimerCallback": "TimerCallback",
    "SDL_NSTimerCallback": "NSTimerCallback",
    "SDL_TrayCallback": "TrayCallback",
    "SDL_EGLAttribArrayCallback": "EGLAttribArrayCallback",
    "SDL_HitTest": "HitTest"
  },
  "Enums": {
    "CustomPrefixes": {
      "SDL_GPUIndexElementSize": "Size",
      "SDL_GPUTextureType": "Type",
      "SDL_GPUSampleCount": "Count",
      "SDL_BitmapOrder": "Order",
      "SDL_PackedLayout": "Layout",
      "SDL_TimeFormat": "Format",
    },
    "PrefixesToStrip": {
      "SDL_AssertState": "ASSERTION",
      "SDL_AsyncIOTaskType": "ASYNCIO_TASK",
      "SDL_AsyncIOResult": "ASYNCIO",
      "SDL_AudioFormat": "AUDIO",
      "SDL_FileDialogType": "FILEDIALOG",
      "SDL_EventType": "EVENT",
      "SDL_EnumerationResult": "ENUM",
      "SDL_GamepadBindingType": "GAMEPAD_BINDTYPE",
      "SDL_JoystickConnectionState": "JOYSTICK_CONNECTION",
      "SDL_Capitalization": "CAPITALIZE", // todo maybe this should be kept as-is
      "SDL_MessageBoxColorType": "MESSAGEBOX_COLOR",
      "SDL_MouseWheelDirection": "MOUSEWHEEL",
      "SDL_ProcessIO": "PROCESS_STDIO",
      "SDL_TextureAddressMode": "TEXTURE_ADDRESS",
      "SDL_RendererLogicalPresentation": "LOGICAL_PRESENTATION",
      "SDL_SensorType": "SENSOR",
      "SDL_FlipMode": "FLIP", // todo maybe this also should be kept as-is?
      "SDL_ThreadState": "THREAD",
      "SDL_TouchDeviceType": "TOUCH_DEVICE",
      "SDL_DisplayOrientation": "ORIENTATION",
      "SDL_FlashOperation": "FLASH",
      "SDL_GLAttr": "GL",
      "SDL_HitTestResult": "HITTEST"
    }
  },
  "Constants": {
    "PrefixRemapping": {
      "SDL_HAPTIC": "HapticType"
    },
    "AssociateConstantPrefixWithType": {
      "SDL_INIT": { "TypeName": "InitFlags", "IsFlagsEnum": true },
      "SDL_WINDOW_": { "TypeName": "WindowFlags", "IsFlagsEnum": true },
      "SDL_GPU_SHADERFORMAT": { "TypeName": "GPUShaderFormat", "IsFlagsEnum": true },
      "SDL_GPU_BUFFERUSAGE": { "TypeName": "GPUBufferUsageFlags", "IsFlagsEnum": true },
      "SDL_GPU_TEXTUREUSAGE": { "TypeName": "GPUTextureUsageFlags", "IsFlagsEnum": true },
      "SDL_MESSAGEBOX": { "TypeName": "MessageBoxFlags", "IsFlagsEnum": true },
      "SDL_BUTTON": { "TypeName": "MouseButtonFlags", "IsFlagsEnum": true },
      "SDL_GL_CONTEXT_RESET": { "TypeName": "GLContextResetNotification", "IsFlagsEnum": true },
      "SDL_GL_CONTEXT_RELEASE_BEHAVIOR": { "TypeName": "GLContextReleaseFlag", "IsFlagsEnum": true },
      "SDL_GL_CONTEXT_PROFILE": { "TypeName": "GLProfile", "IsFlagsEnum": true },
      "SDL_GL_CONTEXT": { "TypeName": "GLContextFlag", "IsFlagsEnum": true },
      "SDLK": { "TypeName": "Keycode", "IsFlagsEnum": true },
      "SDL_KMOD": { "TypeName": "Keymod", "IsFlagsEnum": true },
      "SDL_PEN_INPUT": { "TypeName": "PenInputFlags", "IsFlagsEnum": true },
      "SDL_BLENDMODE": { "TypeName": "BlendMode", "IsFlagsEnum": true },
      "SDL_PROP": { "TypeName": "Prop", "IsFlagsEnum": false },
      "SDL_HINT": { "TypeName": "Hint", "IsFlagsEnum": false }
    }
  },
  "Generator": {
    "UseLibraryImport": true,
    "EmptyStructsAreHandleTypes": true,
    "HandleTypesUseIHandleInterface": true,
    "AllTypesAreSubTypes": true,
    "AllStringsAreUTF8": true,
    "CustomReturnValueTypeMarshallers": {
      "string": "StringMarshaller"
    }
  }
}