{
  "OutputDirectory": "../src/piko.SDL3.ShaderCross",
  "Namespace": "piko.SDL3.ShaderCross",
  "LibraryDllName": "SDL3_shadercross",
  "MethodClassName": "SDLShaderCross",
  "PrefixToStrip": "SDL_ShaderCross_",
  "Analyzer": "ClangSharp",
  "ClangSharp": {
    "FileDirectory": "../lib/SDL_shadercross/include/SDL3_shadercross",
    "Files": [
      "SDL_shadercross.h"
    ],
    "IncludeDirectories": ["../lib/SDL/include"]
  },
  "TypeRemapping": {
    "SDL_GPUDevice": { "Name": "void" },
    "SDL_GPUShader": { "Name": "void" },
    "SDL_GPUComputePipeline": { "Name": "void" },
    "SDL_GPUShaderFormat": { "Name": "SDL.GPUShaderFormat" }
  },
  "Enums": {
    "CustomPrefixes": {},
    "PrefixesToStrip": {}
  },
  "Constants": {
    "PrefixRemapping": {},
    "AssociateConstantPrefixWithType": {
      "SDL_SHADERCROSS_PROP": { "TypeName": "Prop", "TypeToGenerate": "StaticClass" }
    }
  },
  "Generator": {
    "UseLibraryImport": true,
    "EmptyStructsAreHandleTypes": true,
    "HandleTypesUseIHandleInterface": true,
    "AllTypesAreSubTypes": true,
    "AllStringsAreUTF8": true,
    "BytesAreBooleans": true,
    "CustomReturnValueTypeMarshallers": {}
  }
}
